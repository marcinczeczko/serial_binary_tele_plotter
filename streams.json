        "diffbot_pid": {
            "title": "PID Tuning",
            "columns": [
                "Left",
                "Right"
            ],
            "parameters": {
                "kp": {
                    "label": "Kp",
                    "kind": "float",
                    "min": -1000.0,
                    "max": 1000.0,
                    "default": 0.1
                },
                "ki": {
                    "label": "Ki",
                    "kind": "float",
                    "min": -1000.0,
                    "max": 1000.0,
                    "default": 0.02,
                    "decimals": 5,
                    "step": 0.001
                },
                "k1": {
                    "label": "K1",
                    "kind": "float",
                    "min": -1000.0,
                    "max": 1000.0,
                    "default": 26.5,
                    "step": 0.1
                },
                "k2": {
                    "label": "K2",
                    "kind": "float",
                    "min": -1000.0,
                    "max": 1000.0,
                    "default": 8.0,
                    "step": 0.1
                },
                "k3": {
                    "label": "K3",
                    "kind": "float",
                    "min": -1000.0,
                    "max": 1000.0,
                    "default": 5.0,
                    "step": 0.1
                },
                "k_aw": {
                    "label": "Kaw",
                    "kind": "float",
                    "min": -1000.0,
                    "max": 1000.0,
                    "default": 1.0
                },
                "alpha": {
                    "label": "Alpha",
                    "kind": "float",
                    "min": 0.0,
                    "max": 1.0,
                    "default": 0.2
                },
                "rps": {
                    "label": "Rps",
                    "kind": "float",
                    "min": -50.0,
                    "max": 50.0,
                    "default": 0.3
                },
                "use_ramp": {
                    "label": "Use Ramp",
                    "kind": "bool",
                    "default": false
                },
                "use_pi": {
                    "label": "Use PI",
                    "kind": "bool",
                    "default": false
                }
            },
            "buttons": [
                {
                    "label": "Update Left PID",
                    "command": "pid_single",
                    "column": "Left",
                    "values": {
                        "motor_id": 0
                    }
                },
                {
                    "label": "Update Right PID",
                    "command": "pid_single",
                    "column": "Right",
                    "values": {
                        "motor_id": 1
                    }
                },
                {
                    "label": "Run Test (Both Motors)",
                    "command": "pid_both"
                }
            ]
        }
    },
